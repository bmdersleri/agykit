import json, sys
from collections import deque
path, n = sys.argv[1], int(sys.argv[2])
with open(path, errors='replace') as f:
    window = deque(f, maxlen=n)
for line in window:
    line = line.strip()
    if not line:
        continue
    try:
        e = json.loads(line)
        ts   = e.get('ts', '')[-8:] or '?'
        cmd  = e.get('cmd', '?')[:12].ljust(12)
        st   = e.get('status', '?')[:16].ljust(16)
        acct = (e.get('account', '') or '-').split('@')[0][:15].ljust(15)
        mdl  = (e.get('model', '') or '-')[:12]
        print(f"{ts}  {cmd}  {st}  {acct}  {mdl}")
    except json.JSONDecodeError:
        pass
PY
}

