AGYKIT_SYSTEM="${sys_file}"
AGYKIT_FLAGS="--add-dir ${src_dir} --dangerously-skip-permissions"
AGYKIT_TIMEOUT="15m"
AGYKIT_TERSE="${terse}"
CONF
    echo "  ✓ .agykit.conf"

    # Add to .gitignore if git repo
    if git rev-parse --git-dir >/dev/null 2>&1; then
