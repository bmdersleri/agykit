cmd_dash() {
    local self; self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    local repo; repo="$(cd "$(dirname "$self")" && pwd)"
    local dir="$repo/dashboard"
    [ -f "$dir/server.py" ] || { echo "dashboard not found at $dir" >&2; exit 1; }

    local port=8787 host=127.0.0.1
    local bg=0 stop=0 status=0
    local args=()
    local skip_next=0

    local i
    for i in "$@"; do
        if [ "$skip_next" = "1" ]; then
            port="$i"; skip_next=0; continue
        fi
        case "$i" in
            --bg|--start)  bg=1 ;;
            --stop)        stop=1 ;;
            --status)      status=1 ;;
            --port=*)      port="${i#--port=}" ;;
            --port)        skip_next=1 ;;
            *)             args+=("$i") ;;
        esac
    done

    local pidfile="/tmp/agykit-dash-${port}.pid"
    local logfile="/tmp/agykit-dash-${port}.log"

    if [ "$stop" = "1" ]; then
        if [ -f "$pidfile" ]; then
            local pid; pid=$(cat "$pidfile")
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid" && echo "Dashboard durduruldu (PID $pid)"
            else
                echo "Dashboard zaten çalışmıyor."
            fi
            rm -f "$pidfile"
        else
            # PID dosyası yoksa port üzerinden bul
            local pid; pid=$(lsof -ti tcp:${port} 2>/dev/null | head -1)
            if [ -n "$pid" ]; then
                kill "$pid" && echo "Dashboard durduruldu (PID $pid)"
            else
                echo "Dashboard çalışmıyor."
            fi
        fi
        return 0
    fi

    if [ "$status" = "1" ]; then
        if [ -f "$pidfile" ]; then
            local pid; pid=$(cat "$pidfile")
            if kill -0 "$pid" 2>/dev/null; then
                echo "Dashboard çalışıyor — http://${host}:${port}  (PID $pid)"
            else
                echo "Dashboard çalışmıyor (eski PID dosyası var)."
                rm -f "$pidfile"
            fi
        else
            echo "Dashboard çalışmıyor."
        fi
        return 0
    fi

    if [ "$bg" = "1" ]; then
        # Varsa durdur, yeniden başlat
        if [ -f "$pidfile" ]; then
            local oldpid; oldpid=$(cat "$pidfile")
            kill "$oldpid" 2>/dev/null; sleep 0.5
            rm -f "$pidfile"
        fi
        PYTHONPATH="$repo" nohup python3 "$dir/server.py" \
            --host="$host" --port="$port" "${args[@]}" \
            >"$logfile" 2>&1 &
        local newpid=$!
        echo "$newpid" > "$pidfile"
        sleep 1
        if kill -0 "$newpid" 2>/dev/null; then
            echo "Dashboard başlatıldı — http://${host}:${port}  (PID $newpid, log: $logfile)"
        else
            echo "Dashboard başlatılamadı. Log: $logfile" >&2
            cat "$logfile" >&2
            rm -f "$pidfile"
            return 1
        fi
        return 0
    fi

    # Varsayılan: foreground
    exec python3 "$dir/server.py" --host="$host" --port="$port" "${args[@]}"
}

