# ── Task spec runner ──────────────────────────────────────────────────────────
# Parses .agykit-tasks.md and runs tasks via do-escalate.
#
# Spec format:
#   ## task-<id>: <title>
#   depends_on: [task-1, task-2]   (optional, space after colon)
#   verify_hint: <cmd>             (optional — overrides AGYKIT_VERIFY for this task)
#
#   <prompt text — everything until next ## or EOF>
#
cmd_tasks() {
    local subcmd="${1:-list}"; shift || true
    local spec_file="${AGYKIT_TASKS_FILE:-${2:-.agykit-tasks.md}}"
    # Allow: agykit tasks list [file], agykit tasks run [--task id] [file]
    local task_filter=""
    local args=("$@")
    local i=0
    while [ $i -lt ${#args[@]} ]; do
        case "${args[$i]}" in
            --task) i=$((i+1)); task_filter="${args[$i]:-}" ;;
            *.md)   spec_file="${args[$i]}" ;;
        esac
        i=$((i+1))
    done

    [ -f "$spec_file" ] || { echo "Task spec not found: $spec_file"; exit 1; }

    # Parse tasks. Supports two ## header formats:
    #   ## task-<id>: <title>          (canonical)
    #   ## Task N — <title>  or  ## Task N: <title>  (legacy / design specs)
    local tasks_json; tasks_json=$(python3 - "$spec_file" <<'PY'
import sys, re, json

path = sys.argv[1]
text = open(path).read()

# Match either:  ## task-foo: Title  OR  ## Task 3 — Title  OR  ## Task 3: Title
HEADER = re.compile(
    r'^##\s+'
    r'(?:(task-[\w-]+)[:\s]+(.+)'        # group 1=id, 2=title  (canonical)
    r'|Task\s+(\d+)\s*[—:–-]+\s*(.+))'  # group 3=num, 4=title (legacy)
    r'$',
    re.MULTILINE
)

tasks = []
matches = list(HEADER.finditer(text))
for idx, m in enumerate(matches):
    if m.group(1):
        task_id = m.group(1).strip()
        title   = m.group(2).strip()
    else:
        task_id = f"task-{m.group(3)}"
        title   = m.group(4).strip()

    end = matches[idx+1].start() if idx+1 < len(matches) else len(text)
    body = text[m.end():end]

    depends_on = []
    verify_hint = ""
    prompt_lines = []

    for line in body.split('\n'):
        dm = re.match(r'^depends_on:\s*\[([^\]]*)\]', line)
        if dm:
            depends_on = [x.strip() for x in dm.group(1).split(',') if x.strip()]
            continue
        vm = re.match(r'^verify_hint:\s*(.+)', line)
        if vm:
            verify_hint = vm.group(1).strip()
            continue
        prompt_lines.append(line)

    prompt = '\n'.join(prompt_lines).strip()
    tasks.append({
        "id": task_id,
        "title": title,
        "depends_on": depends_on,
        "verify_hint": verify_hint,
        "prompt": prompt,
    })

print(json.dumps(tasks))
PY
    )

    case "$subcmd" in
        list)
            echo "Tasks in $spec_file:"
            echo "$tasks_json" | python3 -c "
import json, sys
tasks = json.load(sys.stdin)
for t in tasks:
    dep = ', '.join(t['depends_on']) or '—'
    print(f\"  {t['id']}: {t['title']}\")
    if t['depends_on']: print(f\"    depends_on: {dep}\")
    if t['verify_hint']: print(f\"    verify: {t['verify_hint']}\")
"
            ;;

        run)
            local orig_verify="$VERIFY_CMD"
            local n_run=0 n_fail=0
            local completed_ids=()

            while IFS= read -r task_json; do
                local tid; tid=$(echo "$task_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['id'])")
                local ttitle; ttitle=$(echo "$task_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['title'])")
                local tdeps; tdeps=$(echo "$task_json" | python3 -c "import json,sys; t=json.loads(sys.stdin.read()); print(' '.join(t['depends_on']))")
                local tvhint; tvhint=$(echo "$task_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['verify_hint'])")
                local tprompt; tprompt=$(echo "$task_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['prompt'])")

                # Filter by --task
                [ -n "$task_filter" ] && [ "$tid" != "$task_filter" ] && continue

                # Check depends_on
                local dep_ok=1
                for dep in $tdeps; do
                    local found=0
                    for cid in "${completed_ids[@]:-}"; do
                        [ "$cid" = "$dep" ] && found=1 && break
                    done
                    if [ $found -eq 0 ]; then
                        echo "==> SKIP $tid: dependency '$dep' not completed"
                        dep_ok=0; break
                    fi
                done
                [ $dep_ok -eq 0 ] && continue

                echo ""
                echo "════ TASK: $tid — $ttitle ════"

                # Override VERIFY_CMD if verify_hint provided
                [ -n "$tvhint" ] && export VERIFY_CMD="$tvhint"

                if cmd_do_escalate "$tprompt"; then
                    completed_ids+=("$tid")
                    n_run=$((n_run+1))
                else
                    echo "==> TASK FAILED: $tid"
                    n_fail=$((n_fail+1))
                    export VERIFY_CMD="$orig_verify"
                    exit 1
                fi

                export VERIFY_CMD="$orig_verify"
            done < <(echo "$tasks_json" | python3 -c "
import json, sys
tasks = json.load(sys.stdin)
for t in tasks:
    import json
    print(json.dumps(t))
")

            echo ""
            echo "════ TASKS DONE: $n_run succeeded, $n_fail failed ════"
            ;;

        *)
            echo "Usage: agykit tasks list [spec.md]"
            echo "       agykit tasks run [--task <id>] [spec.md]"
            exit 1
            ;;
    esac
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
# Guard: when sourced (e.g. by tests) do not run the dispatcher.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
case "${1:-}" in
    whoami)        cmd_whoami ;;
    models)        cmd_models ;;
    model)         cmd_model "${2:-}" ;;
    account-list)  cmd_account_list ;;
    account-save)  cmd_account_save ;;
    account-add)    cmd_account_add ;;
    account-remove) cmd_account_remove "${2:-}" ;;
    switch)        cmd_account_switch "${2:-}" ;;
    run)           cmd_run "${@:2}" ;;
    do-escalate)   cmd_do_escalate "${@:2}" ;;
    tasks)         cmd_tasks "${@:2}" ;;
    dash)          cmd_dash "${@:2}" ;;
    quota)         cmd_quota "${@:2}" ;;
    codex)         cmd_codex "${@:2}" ;;
    status)        cmd_status ;;
    stats)         cmd_jobs --stats ;;
    log)           cmd_log "${2:-}" ;;
    jobs)          cmd_jobs "${@:2}" ;;
    watch)         cmd_job_watch "${2:-}" ;;
    tail)          cmd_job_tail ;;
    cancel)        cmd_job_cancel "${2:-}" ;;
    prune)         cmd_job_prune "${@:2}" ;;
    job-log)       cmd_job_log "${2:-}" ;;
    jobd)          cmd_jobd "${@:2}" ;;
    rtk)           cmd_rtk "${@:2}" ;;
    doctor)        cmd_doctor "${2:-}" ;;
    init)          cmd_init ;;
    -v|--version|version) echo "agykit $AGYKIT_VERSION" ;;
    ""|-h|--help|help) usage ;;
    *)             echo "Unknown command: $1"; usage; exit 1 ;;
esac
fi
