#!/usr/bin/env bash
# agykit — portable Antigravity (agy) CLI manager.
# Account rotation, model+effort selection, quota-aware running, keyring snapshots.
# Orchestrator-agnostic: works with Claude Code, OpenCode, Codex, or standalone.
#
# Config (optional, per-project) via .agykit.conf in CWD or AGYKIT_* env vars:
#   AGYKIT_VERIFY   — command run after a code task (default: none)
#   AGYKIT_SYSTEM   — path to a system-context file injected into prompts
#   AGYKIT_FLAGS    — extra flags for agy (default: --dangerously-skip-permissions)
#   AGYKIT_TIMEOUT  — agy --print-timeout (default: 15m)
#   AGYKIT_TERSE    — 0/lite/full/ultra terse output for run/ask (default: 0)
#   AGYKIT_ARCHITECT_ESCALATE — when set, escalate to architect after LADDER exhausted
#                                value: "claude" (uses claude CLI) or path to a binary
#   AGYKIT_TASKS_FILE — default task spec file for `agykit tasks` (default: .agykit-tasks.md)
set -euo pipefail

AGYKIT_VERSION="1.1.6"
_EMAIL_CACHE=""

GEMINI_DIR="$HOME/.gemini"
AGY_SETTINGS="$GEMINI_DIR/antigravity-cli/settings.json"
ACCOUNTS_DIR="$GEMINI_DIR/accounts"
KEYRING_SVC="gemini"
KEYRING_USER="antigravity"
# Match HTTP 429 status (word boundary) but NOT timestamps like 18:40:55.429005
QUOTA_RE='quota reached|RESOURCE_EXHAUSTED|rate.?limit|code 429|HTTP.*429|error.*429|exceeded your current|too many request'
LADDER=("Gemini 3.5 Flash (Medium)" "Gemini 3.1 Pro (High)" "Claude Opus 4.6 (Thinking)")

# ── Load per-project config ──────────────────────────────────────────────────
[ -f ".agykit.conf" ] && source ".agykit.conf"
VERIFY_CMD="${AGYKIT_VERIFY:-}"
if [ -n "${AGYKIT_SYSTEM:-}" ]; then
    SYSTEM_FILE="$AGYKIT_SYSTEM"
else
    SYSTEM_FILE="$(_agent_system_file)"
fi
AGY_FLAGS="${AGYKIT_FLAGS:---dangerously-skip-permissions}"
TIMEOUT="${AGYKIT_TIMEOUT:-15m}"
# agy binary — overridable for testing with a stub.
AGY_BIN="${AGY_BIN:-agy}"
# AGYKIT_TERSE: caveman-style terse output for explanation prompts (run/ask).
# Saves OUTPUT tokens → quota lasts longer. NOT applied to code tasks
# (do-escalate) where verbosity may carry signal.
# Levels: 0/off (default) | lite | full | ultra
#   lite  — no filler/hedging, keep articles + full sentences
#   full  — drop articles, fragments OK, short synonyms (classic caveman)
#   ultra — abbreviate prose (DB/auth/cfg/fn), arrows for causality (X→Y),
#           one word when one word enough. Code/API/error strings never abbreviated.
# Backward compat: "1" = full.
TERSE="${AGYKIT_TERSE:-ultra}"
[ "$TERSE" = "1" ] && TERSE="full"

_terse_directive() {
    case "$TERSE" in
        lite)  echo 'Respond tight and professional. Drop filler (just/really/basically) and hedging. Keep articles and full sentences. Technical terms and code exact.' ;;
        full)  echo 'Respond terse like smart caveman. Drop articles (a/an/the), filler, pleasantries, hedging. Fragments OK. Short synonyms. Technical terms exact, code blocks unchanged. Pattern: [thing] [action] [reason].' ;;
        ultra) echo 'Respond ultra-terse. Abbreviate prose words (DB/auth/cfg/req/res/fn/impl), strip conjunctions, use arrows for causality (X → Y), one word when one word enough. NEVER abbreviate code symbols, function names, API names, error strings. Code blocks unchanged.' ;;
        *)     echo '' ;;
    esac
}

# System-context prefix (optional file)
_system_prefix() {
    if [ -n "$SYSTEM_FILE" ] && [ -f "$SYSTEM_FILE" ]; then
        cat "$SYSTEM_FILE"; printf '\n\n---\n\n'
    fi
}

# Terse prefix — only when AGYKIT_TERSE set to a level. For explanation prompts.
_terse_prefix() {
    local d; d=$(_terse_directive)
    [ -n "$d" ] && printf '%s\n\n' "$d"
}

# ── Email from keyring access_token via Google userinfo (cached per session) ──
_active_email() {
    if [ -n "$_EMAIL_CACHE" ]; then echo "$_EMAIL_CACHE"; return; fi
    _EMAIL_CACHE=$(python3 - <<'PY' 2>/dev/null
import keyring, json, urllib.request
v = keyring.get_password('gemini', 'antigravity')
if not v: print(""); raise SystemExit
try:
    at = json.loads(v)['token']['access_token']
    req = urllib.request.Request(
        'https://www.googleapis.com/oauth2/v3/userinfo',
        headers={'Authorization': f'Bearer {at}'})
    print(json.loads(urllib.request.urlopen(req, timeout=5).read()).get('email',''))
except Exception:
    print("(unknown)")
PY
)
    echo "$_EMAIL_CACHE"
}

# ── Git safety: snapshot / normalize / rollback ──────────────────────────────
# do-escalate runs agy with the user's working tree fully visible (so agy and
# the verify command both see uncommitted WIP, e.g. failing tests). To stay
# safe we snapshot the pre-run state non-destructively, neutralize any stray
# git writes agy makes, and on failure restore the exact pre-run tree.

_in_git() { git rev-parse --git-dir >/dev/null 2>&1; }

# Capture tracked WIP + untracked files into a commit object WITHOUT touching
# the working tree or the user's index. Echoes the snapshot commit sha ("" if
# not a git repo). Uses a throwaway index so staged/unstaged state is preserved.
_snapshot() {
    _in_git || { echo ""; return 0; }
    local base; base=$(git rev-parse -q --verify HEAD 2>/dev/null || echo "")
    local tmpidx; tmpidx=$(mktemp -u "${TMPDIR:-/tmp}/agykit-idx.XXXXXX")
    if [ -n "$base" ]; then
        GIT_INDEX_FILE="$tmpidx" git read-tree "$base" 2>/dev/null || true
    fi
    GIT_INDEX_FILE="$tmpidx" git add -A 2>/dev/null || true
    local tree; tree=$(GIT_INDEX_FILE="$tmpidx" git write-tree 2>/dev/null || echo "")
    rm -f "$tmpidx"
    [ -z "$tree" ] && { echo ""; return 0; }
    if [ -n "$base" ]; then
        git commit-tree "$tree" -p "$base" -m "agykit-snapshot" 2>/dev/null || echo ""
    else
        git commit-tree "$tree" -m "agykit-snapshot" 2>/dev/null || echo ""
    fi
}

# If agy moved HEAD (committed or reset), bring HEAD back to $1 (BASE) while
# leaving every change in the working tree. Turns "agy committed" into plain
# uncommitted edits — agykit owns version control, not agy.
_normalize_head() {
    local base="$1"
    { _in_git && [ -n "$base" ]; } || return 0
    if [ "$(git rev-parse HEAD 2>/dev/null)" != "$base" ]; then
        git reset --mixed "$base" >/dev/null 2>&1 || true
    fi
}

# Restore the working tree to snapshot $2 taken at BASE $1: drop agy's tracked
# and untracked changes, then re-materialize the user's pre-run WIP exactly.
_rollback_to() {
    local base="$1" snap="$2"
    { _in_git && [ -n "$base" ]; } || return 0
    git reset -q --hard "$base" 2>/dev/null || true
    git clean -fdq 2>/dev/null || true
    if [ -n "$snap" ]; then
        git checkout "$snap" -- . 2>/dev/null || true   # restore WIP (tracked + previously-untracked)
        git reset -q "$base" 2>/dev/null || true         # unstage; keep working-tree content
    fi
}

# Injected into the agy task prompt: defense-in-depth so agy doesn't fight
# agykit over git state.
_git_lock_directive() {
    printf '%s\n\n' 'RULE: Edit files only. Do NOT run git commit, git reset, git rebase, git push, or git stash — agykit manages version control. Make changes directly in the working tree and stop.'
}

# ── Account quota sorting ────────────────────────────────────────────────────
# Sort emails: available accounts first, exhausted last (reads agy log files).
# Falls back to original order on any error. O(n log n) over log files, ~50ms.
_accounts_sorted_by_quota() {
    local self; self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    local repo; repo="$(cd "$(dirname "$self")" && pwd)"
    python3 - "$repo" "$@" <<'PY'
import sys, os
repo = sys.argv[1]; emails = sys.argv[2:]
if not emails: sys.exit(0)
if repo not in sys.path: sys.path.insert(0, repo)
try:
    from dashboard import collectors
    status = {a['email']: a.get('status', 'available')
              for a in collectors.agy_quota_status().get('accounts', [])}
    emails.sort(key=lambda e: 0 if status.get(e, 'available') == 'available' else 1)
except Exception:
    pass
print('\n'.join(emails))
PY
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_whoami()  { echo "Active: $(_active_email)"; }

cmd_models() {
    echo "Known agy models (model + effort):"
    for m in "${LADDER[@]}"; do echo "  $m"; done
    echo "  Gemini 3.5 Flash (High)"
    echo "Active: $(python3 -c "import json;print(json.load(open('$AGY_SETTINGS')).get('model'))")"
}

cmd_model() {
    if [ -z "${1:-}" ]; then
        python3 -c "import json;print('Active model:',json.load(open('$AGY_SETTINGS')).get('model'))"
        return
    fi
    AGY_SETTINGS="$AGY_SETTINGS" python3 - "$1" <<'PY'
import json, os, sys
p = os.environ['AGY_SETTINGS']; new = sys.argv[1]
d = json.load(open(p)); old = d.get('model'); d['model'] = new
json.dump(d, open(p,'w'), indent=2); print(f'==> model: {old}  ->  {new}')
PY
}

cmd_account_list() {
    local active; active=$(_active_email)
    echo "Active: ${active:-none}"
    echo "Saved snapshots:"
    if [ -d "$ACCOUNTS_DIR" ]; then
        for f in "$ACCOUNTS_DIR"/*.json; do
            [ -e "$f" ] || continue
            local name; name=$(basename "$f" .json)
            [ "$name" = "$active" ] && echo "  - $name (active)" || echo "  - $name"
        done
    else echo "  (none — run: agykit account-save)"; fi
}

cmd_account_save() {
    python3 - <<'PY'
import keyring, json, os, urllib.request
v = keyring.get_password('gemini','antigravity')
if not v: print("No active account"); raise SystemExit(1)
at = json.loads(v)['token']['access_token']
req = urllib.request.Request('https://www.googleapis.com/oauth2/v3/userinfo',
    headers={'Authorization': f'Bearer {at}'})
email = json.loads(urllib.request.urlopen(req,timeout=5).read())['email']
d = os.path.expanduser('~/.gemini/accounts'); os.makedirs(d, exist_ok=True)
p = os.path.join(d, email+'.json')
open(p,'w').write(v); os.chmod(p,0o600)
print(f"==> Saved: {email} -> {p}")
PY
}

cmd_account_remove() {
    [ -z "${1:-}" ] && { echo "Usage: agykit account-remove <email>"; exit 1; }
    local email="$1"
    local snap="$ACCOUNTS_DIR/${email}.json"
    [ ! -f "$snap" ] && { echo "No snapshot found for: $email"; exit 1; }
    local active; active=$(_active_email)
    if [ "$active" = "$email" ]; then
        echo "Cannot remove active account. Switch to another account first:"
        echo "  agykit switch <other-email>"
        exit 1
    fi
    rm "$snap"
    echo "Removed: $email"
    cmd_account_list
}

cmd_account_add() {
    echo "════ agy launching — /logout, login with NEW account, then ctrl+d ════"
    "$AGY_BIN" </dev/tty || true
    cmd_account_save
    cmd_account_list
}

cmd_account_switch() {
    [ -z "${1:-}" ] && { echo "Usage: agykit switch <email>"; exit 1; }
    # Returns "EXPIRED" on stdout if the switched-in token needs refreshing.
    local need_refresh
    need_refresh=$(python3 - "$1" <<'PY'
import keyring, json, os, sys, urllib.request, datetime
email = sys.argv[1]
p = os.path.expanduser(f'~/.gemini/accounts/{email}.json')
if not os.path.exists(p): print(f"NOSNAP", file=sys.stderr); raise SystemExit(2)
cur = keyring.get_password('gemini','antigravity')
if cur:
    try:
        at = json.loads(cur)['token']['access_token']
        req = urllib.request.Request('https://www.googleapis.com/oauth2/v3/userinfo',
            headers={'Authorization': f'Bearer {at}'})
        ce = json.loads(urllib.request.urlopen(req,timeout=5).read())['email']
        if ce != email:
            bp = os.path.expanduser(f'~/.gemini/accounts/{ce}.json')
            open(bp,'w').write(cur); os.chmod(bp,0o600)
    except Exception: pass
data = open(p).read()
keyring.set_password('gemini','antigravity', data)
# Check if the new token is expired → signal refresh needed
try:
    exp = json.loads(data)['token'].get('expiry','')
    if exp:
        # ISO 8601 with tz; compare to now
        t = datetime.datetime.fromisoformat(exp.replace('Z','+00:00'))
        if t <= datetime.datetime.now(datetime.timezone.utc):
            print("EXPIRED")
except Exception:
    pass
PY
    ) || { echo "No snapshot for $1"; exit 1; }
    echo "==> Switched to $1"
    # Auto-refresh: agy renews the access_token from refresh_token on its first call.
    if [ "$need_refresh" = "EXPIRED" ]; then
        echo "==> token expired — refreshing via agy..."
        "$AGY_BIN" -p "ok" --dangerously-skip-permissions >/dev/null 2>&1 || true
    fi
}

# Append a single JSON line to ~/.gemini/agykit-ops.log
# Uses python3 for safe JSON serialization (escapes quotes/backslashes in prompt).
# Rotates to last 400 entries when file exceeds 512KB.
_ops_log() {
    local cmd="$1" status="$2" account="${3:-}" model="${4:-}" prompt_preview="${5:-}"
    python3 - \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$cmd" "$status" \
        "$account" "$model" "$prompt_preview" \
        "$HOME/.gemini/agykit-ops.log" <<'PY'
import json, sys, os
ts, cmd, status, account, model, prompt, path = sys.argv[1:8]
entry = json.dumps({'ts': ts, 'cmd': cmd, 'status': status,
                    'account': account, 'model': model, 'prompt': prompt})
with open(path, 'a') as f:
    f.write(entry + '\n')
try:
    if os.path.getsize(path) > 524288:
        with open(path) as f:
            lines = [l for l in f if l.strip()]
        with open(path, 'w') as f:
            f.writelines(lines[-400:])
except Exception:
    pass
PY
}

# ── Job observability helpers ──────────────────────────────────────────────
# Wraps the dashboard.collectors.jobs Python module for use in bash commands.
_job_op() {
    local self; self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    local repo; repo="$(cd "$(dirname "$self")" && pwd)"
    PYTHONPATH="$repo" python3 - "$@" <<'PY'
import sys
sys.path.insert(0, '')
from dashboard.collectors.jobs import (
    job_create, job_event, job_snapshot,
    job_events, job_list, job_set_verify_result,
    job_set_diff, job_cancel,
)
op = sys.argv[1]
if op == "create":
    print(job_create(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else ""))
elif op == "event":
    job_event(
        job_id=sys.argv[2],
        event_type=sys.argv[3],
        status=sys.argv[4],
        stage=sys.argv[5],
        account=sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else None,
        model=sys.argv[7] if len(sys.argv) > 7 and sys.argv[7] else None,
        message=sys.argv[8] if len(sys.argv) > 8 else "",
        error=sys.argv[9] if len(sys.argv) > 9 and sys.argv[9] else None,
    )
elif op == "set-verify-result":
    job_set_verify_result(sys.argv[2], sys.argv[3])
elif op == "set-diff":
    job_set_diff(sys.argv[2], sys.argv[3])
elif op == "cancel":
    msg = sys.argv[3] if len(sys.argv) > 3 else ""
    job_cancel(sys.argv[2], msg)
PY
}

# Check for active jobs before starting a new one.
# Returns 0 if safe to start, 1 if active jobs exist.
_can_start_job() {
    local force=0; [ "${1:-}" = "--force" ] && force=1
    local repo; repo=$(_cmd_job_repo)
    PYTHONPATH="$repo" python3 -c "
import sys
sys.path.insert(0, '$repo')
from dashboard.collectors.jobs import job_list, _ACTIVE_STATUSES
active = [j for j in job_list(limit=50) if j.get('status') in _ACTIVE_STATUSES]
if active:
    print(f'WARNING: {len(active)} job(s) still active:', file=sys.stderr)
    for j in active:
        print(f'  {j[\"job_id\"]}  {j.get(\"command\",\"\")}', file=sys.stderr)
    sys.exit(1)
" 2>&1 || [ "$force" -eq 1 ] || { echo "Use --force to start anyway."; return 1; }
    return 0
}

# Run agy with quota-aware account rotation. Returns 0 on first success.
# Accounts sorted by quota status: available first, exhausted last.
cmd_run() {
    local prompt="" force=0; local args=("$@")
    for a in "${args[@]}"; do
        if [ "$a" = "--force" ]; then force=1; else prompt="$a"; fi
    done
    [ -z "$prompt" ] && { echo "Usage: agykit run [--force] <prompt>"; exit 1; }
    mapfile -t raw_accts < <(ls "$ACCOUNTS_DIR"/*.json 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.json$//')
    [ ${#raw_accts[@]} -eq 0 ] && { echo "No saved accounts."; exit 1; }
    _can_start_job "$([ "$force" -eq 1 ] && echo "--force")" || exit 1
    mapfile -t accts < <(_accounts_sorted_by_quota "${raw_accts[@]}")
    _job_ensure_daemon
    local job_id; job_id=$(_job_op create "run" "$prompt")
    _CURRENT_JOB_ID="$job_id"
    _job_cleanup() {
        [ -n "${_CURRENT_JOB_ID:-}" ] && {
            _job_op event "$_CURRENT_JOB_ID" "job_blocked" "blocked" "interrupted" \
                "" "" "Process interrupted (SIGINT/SIGTERM)"
        }
    }
    trap _job_cleanup EXIT INT TERM
    for a in "${accts[@]}"; do
        cmd_account_switch "$a" >/dev/null 2>&1 || continue
        echo "==> Trying account: $a"
        _job_op event "$job_id" "account_selected" "running" "account $a" "$a"
        "$AGY_BIN" -p "$(_system_prefix)$(_terse_prefix)$prompt" $AGY_FLAGS --print-timeout "$TIMEOUT" 2>&1 | tee /tmp/agykit-out.log
        grep -qiE "$QUOTA_RE" /tmp/agykit-out.log && { echo "==> QUOTA on $a — rotating"; _ops_log "run" "quota-rotate" "$a" "" "${prompt:0:80}"; _job_op event "$job_id" "quota_rotated" "rotating" "quota rotate $a" "$a" "" "Quota on $a, rotating"; continue; }
        echo "==> Success on: $a"; _ops_log "run" "success" "$a" "" "${prompt:0:80}"; _job_op event "$job_id" "job_succeeded" "succeeded" "done" "$a"; _quota_alert; trap - EXIT INT TERM; _CURRENT_JOB_ID=""; return 0
    done
    echo "==> ALL ACCOUNTS EXHAUSTED"; _ops_log "run" "exhausted" "" "" "${prompt:0:80}"; _job_op event "$job_id" "job_failed" "failed" "exhausted" "" "" "All accounts exhausted"; trap - EXIT INT TERM; _CURRENT_JOB_ID=""; return 1
}

# Escalating do: model ladder on verify failure + quota rotation + git safety.
# The working tree (incl. uncommitted WIP) stays visible to agy and to verify.
# A non-destructive snapshot lets us roll back ONLY agy's changes on failure,
# and _normalize_head neutralizes any commit/reset agy makes on its own.
cmd_do_escalate() {
    local prompt="" force=0; local args=("$@")
    for a in "${args[@]}"; do
        if [ "$a" = "--force" ]; then force=1; else prompt="$a"; fi
    done
    [ -z "$prompt" ] && { echo "Usage: agykit do-escalate [--force] <prompt>"; exit 1; }
    [ -z "$VERIFY_CMD" ] && { echo "AGYKIT_VERIFY not set — escalate needs a verify command"; exit 1; }
    _can_start_job "$([ "$force" -eq 1 ] && echo "--force")" || exit 1
    local orig; orig=$(python3 -c "import json;print(json.load(open('$AGY_SETTINGS')).get('model',''))")
    mapfile -t raw_accts < <(ls "$ACCOUNTS_DIR"/*.json 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.json$//')
    [ ${#raw_accts[@]} -eq 0 ] && { echo "No saved accounts."; exit 1; }
    mapfile -t accts < <(_accounts_sorted_by_quota "${raw_accts[@]}")
    restore_model() { cmd_model "$orig" >/dev/null 2>&1 || true; }

    local base=""; _in_git && base=$(git rev-parse -q --verify HEAD 2>/dev/null || echo "")
    _in_git || echo "==> ⚠ not a git repo — rollback safety disabled"

    local verify_ctx=""
    _job_ensure_daemon
    local job_id; job_id=$(_job_op create "do-escalate" "$prompt")
    _CURRENT_JOB_ID="$job_id"
    _job_cleanup() {
        [ -n "${_CURRENT_JOB_ID:-}" ] && {
            _job_op event "$_CURRENT_JOB_ID" "job_blocked" "blocked" "interrupted" \
                "" "" "Process interrupted (SIGINT/SIGTERM)"
        }
    }
    trap _job_cleanup EXIT INT TERM

    for model in "${LADDER[@]}"; do
        echo "════ MODEL: $model ════"
        cmd_model "$model" >/dev/null
        _job_op event "$job_id" "model_selected" "running" "model $model" "" "$model"
        local snap=""; _in_git && snap=$(_snapshot)
        local applied=0
        for a in "${accts[@]}"; do
            cmd_account_switch "$a" >/dev/null 2>&1 || continue
            local agy_ok=0 agy_attempt=0
            while [ $agy_attempt -le 2 ] && [ $agy_ok -eq 0 ]; do
                [ $agy_attempt -gt 0 ] && {
                    local w=$((5 * agy_attempt))
                    echo "==> TRANSIENT ERROR — retry $agy_attempt/2 in ${w}s"
                    sleep $w
                }
                echo "==> $model @ $a${agy_attempt:+" (attempt $((agy_attempt+1))/3)"}"
                [ $agy_attempt -eq 0 ] && _job_op event "$job_id" "account_selected" "running" "$model @ $a" "$a" "$model"
                "$AGY_BIN" -p "$(_system_prefix)$(_git_lock_directive)${verify_ctx}TASK: $prompt" $AGY_FLAGS --print-timeout "$TIMEOUT" 2>&1 | tee /tmp/agykit-out.log
                agy_attempt=$((agy_attempt + 1))
                grep -qiE "$QUOTA_RE" /tmp/agykit-out.log && {
                    echo "==> QUOTA on $a"; _ops_log "do-escalate" "quota-rotate" "$a" "$model" "${prompt:0:80}"
                    _job_op event "$job_id" "quota_rotated" "rotating" "quota rotate $a" "$a" "$model" "Quota on $a at $model"
                    _rollback_to "$base" "$snap"
                    agy_ok=2; break
                }
                if [ $agy_attempt -le 2 ] && grep -qiE "ConnectionError|Connection refused|reset by peer|Name or service not known|timed ?out|DeadlineExceeded|UNAVAILABLE" /tmp/agykit-out.log; then
                    _job_op event "$job_id" "job_retrying" "running" "retry $agy_attempt/2 $model @ $a" "$a" "$model" "Transient error, retry ${agy_attempt}/2"
                    continue
                fi
                agy_ok=1
            done
            [ "$agy_ok" = "1" ] && { applied=1; break; }
            [ "$agy_ok" = "2" ] && continue
            echo "==> FAILED on $model @ $a (transient)"
        done
        [ "$applied" -eq 0 ] && { echo "==> ACCOUNTS EXHAUSTED at $model"; _ops_log "do-escalate" "exhausted" "" "$model" "${prompt:0:80}"; _job_op event "$job_id" "job_failed" "failed" "accounts exhausted" "" "$model" "Accounts exhausted at $model"; _rollback_to "$base" "$snap"; restore_model; exit 1; }

        _normalize_head "$base"

        _job_op event "$job_id" "verify_started" "verifying" "verify $model" "$a" "$model"
        if eval "$VERIFY_CMD" >/tmp/agykit-verify.log 2>&1; then
            restore_model
            _job_op event "$job_id" "verify_passed" "succeeded" "done" "$a" "$model" "Verify passed on $model"
            _job_op set-verify-result "$job_id" "passed"
            if _in_git && [ -n "$snap" ]; then
                echo "==> agy changes (review before committing):"
                git --no-pager diff --stat "$snap" 2>/dev/null || true
                local diff_out; diff_out=$(git --no-pager diff "$snap" 2>/dev/null | head -c 32768 || true)
                [ -n "$diff_out" ] && _job_op set-diff "$job_id" "$diff_out"
            fi
            echo "==> SUCCESS with $model"; _ops_log "do-escalate" "success" "$a" "$model" "${prompt:0:80}"; _quota_alert; trap - EXIT INT TERM; _CURRENT_JOB_ID=""; return 0
        else
            local vout; vout=$(tail -30 /tmp/agykit-verify.log 2>/dev/null || echo "")
            [ -n "$vout" ] && verify_ctx="Previous attempt with model '$model' failed verification. Error:
${vout}

Fix the above issues, then complete the original task:
"
            echo "==> verify FAILED on $model — escalating"; _ops_log "do-escalate" "verify-failed" "$a" "$model" "${prompt:0:80}"
            _job_op event "$job_id" "verify_failed" "rolling_back" "verify failed $model" "$a" "$model" "" "$vout"
            _job_op event "$job_id" "rollback_started" "rolling_back" "rollback $model" "" "$model" "Rolling back after verify failure on $model"
            _rollback_to "$base" "$snap"
        fi
    done
    # All LADDER models exhausted — optionally escalate to architect
    if [ -n "${AGYKIT_ARCHITECT_ESCALATE:-}" ]; then
        echo "==> ESCALATING to architect (AGYKIT_ARCHITECT_ESCALATE=$AGYKIT_ARCHITECT_ESCALATE)"
        _job_op event "$job_id" "architect_escalate" "running" "architect review" "" "" "All models failed; escalating to architect"
        local vlog=""; [ -f /tmp/agykit-verify.log ] && vlog=$(tail -50 /tmp/agykit-verify.log 2>/dev/null || true)
        local diff_ctx=""; _in_git && [ -n "$base" ] && diff_ctx=$(git --no-pager diff "$base" 2>/dev/null | head -c 8192 || true)
        local arch_prompt
        arch_prompt="You are the architect reviewing a failed automated coding task.

## Original Task
${prompt}

## Verify Command
${VERIFY_CMD:-<none>}

## Last Verify Output
\`\`\`
${vlog:-<empty>}
\`\`\`

## Current Diff (vs pre-task baseline)
\`\`\`diff
${diff_ctx:-<no git diff available>}
\`\`\`

## Your Job
Analyze why all automated attempts failed. Provide:
1. Root cause (1-2 sentences)
2. Concrete fix instructions the coder should apply (numbered steps)
3. Any code snippets needed

Be specific and actionable. The coder is an AI agent that will re-attempt this task."

        local arch_out
        case "$AGYKIT_ARCHITECT_ESCALATE" in
            claude)
                arch_out=$(claude -p "$arch_prompt" --print 2>/dev/null || echo "Architect unavailable")
                ;;
            *)
                arch_out=$(echo "$arch_prompt" | "$AGYKIT_ARCHITECT_ESCALATE" 2>/dev/null || echo "Architect unavailable")
                ;;
        esac
        echo ""
        echo "════ ARCHITECT REVIEW ════"
        echo "$arch_out"
        echo "══════════════════════════"
        _job_op event "$job_id" "architect_reviewed" "failed" "architect done" "" "" "$arch_out"
    fi

    echo "==> FAILED — all models exhausted"; _ops_log "do-escalate" "all-exhausted" "" "" "${prompt:0:80}"; _job_op event "$job_id" "job_failed" "failed" "all models exhausted" "" "" "All models failed"; restore_model; trap - EXIT INT TERM; _CURRENT_JOB_ID=""; return 1
}

