SYS
        echo "  ✓ $sys_file (edit to describe your project)"
    else
        echo "  ✓ $sys_file already exists"
    fi

    # OpenCode: scaffold .opencode/commands/agykit.md
    if [ "$agent" = "opencode" ] && [ ! -f ".opencode/commands/agykit.md" ]; then
        mkdir -p .opencode/commands
        if [ ! -f ".opencode/commands/agykit.md" ]; then
