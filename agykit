cmd_init() {
    echo "═══ agykit init — project setup ═══"
    if [ -f ".agykit.conf" ]; then
        echo ".agykit.conf already exists in $(pwd). Delete it to reinitialize."; exit 1
    fi
    local project_name; project_name=$(basename "$PWD")
    echo "Project: $project_name  ($(pwd))"; echo

    # Auto-detect defaults
    local verify_default="" src_default="\$PWD"
    [ -d "src" ] && src_default="\$PWD/src"
    if   [ -f "pyproject.toml" ] || [ -f "setup.py" ] || [ -f "requirements.txt" ]; then
        verify_default="python3 -m pytest -q"
    elif [ -f "package.json" ]; then
        verify_default="npm test"
    elif [ -f "Cargo.toml" ]; then
        verify_default="cargo test"; src_default="\$PWD/src"
    elif [ -f "go.mod" ]; then
        verify_default="go test ./..."; src_default="\$PWD"
    elif [ -f "justfile" ] || [ -f "Justfile" ]; then
        verify_default="just test"
    fi

    local agent; agent="$(_detect_agent)"
    local sys_file; sys_file="$(_agent_system_file)"
    echo "Detected agent: $agent  →  $sys_file"
    echo

    printf "Verify command [%s]: " "$verify_default"; read -r v_in
    local verify="${v_in:-$verify_default}"
    printf "Source dir for --add-dir [%s]: " "$src_default"; read -r s_in
    local src_dir="${s_in:-$src_default}"
