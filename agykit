    local repo; repo=$(_cmd_job_repo)
    # Try TUI (Textual) first; gracefully fall back to terminal watch
    if ! PYTHONPATH="$repo" python3 -c "
import sys
sys.path.insert(0, '$repo')
from dashboard.tui import watch_job_tui
if not watch_job_tui('$job_id'):
    raise SystemExit(99)
" 2>/dev/null; then
        # Textual not available or TUI failed — use polling watch
        echo "TUI unavailable, using terminal watch…" >&2
    else
        return 0
    fi
    # Fallback: simple terminal watch
    PYTHONPATH="$repo" python3 - "$job_id" <<'PY'
import sys, os, time, socket, json
sys.path.insert(0, '')
from dashboard.collectors.jobs import job_snapshot, job_events, _JOB_SOCKET
job_id = sys.argv[1]
snap = job_snapshot(job_id)
if not snap:
    print(f"Job {job_id} not found.")
    raise SystemExit(1)
def _redraw(snap, events):
    os.system('clear' if os.name == 'posix' else 'cls')
    print(f"Job: {snap['job_id']}")
    print(f"Command: {snap.get('command', '')}")
    status = snap.get('status', '')
    stage = snap.get('stage', '')
    account = snap.get('account') or '\u2014'
    model = snap.get('model') or '\u2014'
    print(f"Status: {status}  |  Stage: {stage}")
    print(f"Account: {account}  |  Model: {model}")
    if snap.get('last_error'):
        print(f"Error: {snap['last_error']}")
    print(f"Started: {snap.get('started_at', '\u2014')}")
    if snap.get('ended_at'):
        print(f"Ended:   {snap['ended_at']}")
    print()
    for e in events[-10:]:
        ts = e.get('ts', '')[-8:]
        msg = e.get('message', '') or ''
        print(f"  {ts}  {e.get('event', ''):<20} {msg}")
    if snap.get('status') in ('succeeded', 'failed', 'blocked'):
        print(f"\nFinal status: {status}")
        return True
    return False
events = job_events(job_id)
done = _redraw(snap, events)
if done:
    raise SystemExit(0)
# Socket listener (falls back to 1s SQLite polling)
sock = None
try:
    if os.path.exists(_JOB_SOCKET):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        sock.settimeout(1.0)
        sock.bind(_JOB_SOCKET + f".{os.getpid()}.watch")
except Exception:
    sock = None
try:
    while True:
        got_data = False
        if sock is not None:
            try:
                data = sock.recv(4096)
                got_data = True
            except socket.timeout:
                pass
        if not got_data:
            snap = job_snapshot(job_id)
            events = job_events(job_id)
            if _redraw(snap, events):
                break
except KeyboardInterrupt:
    pass
finally:
    if sock is not None:
        try:
            os.unlink(_JOB_SOCKET + f".{os.getpid()}.watch")
        except Exception:
            pass
        sock.close()
PY
}

