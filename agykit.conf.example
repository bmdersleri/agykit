# agykit per-project config — copy to your project root as .agykit.conf
# Sourced by agykit when run from that directory.

# Verify command run after a code task (required for `agykit do-escalate`)
# Examples: "just spec-verify" | "npm test" | "pytest -q" | "cargo test"
AGYKIT_VERIFY="just spec-verify"

# System context file injected into every agy prompt (optional)
AGYKIT_SYSTEM="CLAUDE_AGY_SYSTEM.md"

# Extra agy flags (optional)
AGYKIT_FLAGS="--add-dir $PWD --dangerously-skip-permissions"

# agy print timeout (optional, default 15m)
AGYKIT_TIMEOUT="15m"

# Hard job ceiling in seconds (optional, default 1800). Past this a job is
# reaped and SIGTERM'd regardless of its owner PID — the runaway backstop.
# Keep >= AGYKIT_TIMEOUT or long agy runs get cut off mid-flight. 0/empty = off.
AGYKIT_JOB_TIMEOUT="1800"

# Terse (caveman-style) output for `agykit run` — saves output tokens, quota
# lasts longer. Only affects run/ask explanation prompts, NOT do-escalate code.
# Levels: 0/off | lite | full | ultra  (default: ultra)
#   lite  — no filler/hedging, keep full sentences
#   full  — drop articles, fragments, caveman pattern
#   ultra — abbreviate prose, arrows (X→Y), maximum compression
AGYKIT_TERSE="ultra"

# ── Quota alert settings ─────────────────────────────────────────────────────

# Alert when a model's remaining quota falls below this percentage (default: 15)
# AGYKIT_QUOTA_ALERT_PCT=15

# Minimum seconds between repeat alerts for the same account+model (default: 3600)
# AGYKIT_ALERT_COOLDOWN=3600

# Telegram channel — set both to enable Telegram alerts
# AGYKIT_TG_BOT_TOKEN=your-bot-token
# AGYKIT_TG_CHAT_ID=your-chat-id
